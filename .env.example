# ── GoHighLevel ───────────────────────────────────────────────────────────────
# Private Integration Token (Settings → Private Integrations → New)
# Scopes: conversations.write, conversations/message.write, contacts.readonly,
#         contacts.write (nur für Tagging bei Opt-out)
GHL_TOKEN=pit-xxxxxxxxxxxxxxxxxxxxxxxx
GHL_LOCATION_ID=xxxxxxxxxxxxxxxxxxxx

# API-Version-Header. Conversations läuft auf 2021-04-15, Contacts auf 2021-07-28.
GHL_API_VERSION_CONVERSATIONS=2021-04-15
GHL_API_VERSION_CONTACTS=2021-07-28

# Optional: Absendernummer erzwingen (sonst nutzt GHL die Default-Nummer der Location)
# GHL_FROM_NUMBER=+6281234567890

# ── Tempo & Schutz ────────────────────────────────────────────────────────────
TZ=Asia/Makassar

# Maximal so viele Erstnachrichten pro Kalendertag
DAILY_CAP=30

# Sendefenster in lokaler Zeit (Stunde, 24h). Ausserhalb wird nichts gesendet.
SEND_WINDOW_START=9
SEND_WINDOW_END=18

# Zufälliger Abstand zwischen zwei Sends, in Sekunden
MIN_GAP_SECONDS=240
MAX_GAP_SECONDS=900

# Follow-up: nach so vielen Stunden ohne Antwort kommt Step 2. 0 = kein Follow-up.
FOLLOWUP_AFTER_HOURS=48

# Maximal so viele Nachrichten an einen Kontakt, der nie antwortet
MAX_MESSAGES_WITHOUT_REPLY=2

# ── Reply-Rate-Bremse ─────────────────────────────────────────────────────────
# Sinkt die Reply-Rate der letzten N Sends unter FLOOR, pausiert die Kampagne.
REPLY_RATE_WINDOW=25
REPLY_RATE_FLOOR=0.2
# Erst ab so vielen Sends wird überhaupt geprüft (sonst bremst der Kaltstart)
REPLY_RATE_MIN_SAMPLE=15

# ── Betrieb ───────────────────────────────────────────────────────────────────
PORT=3000
DATA_DIR=/data
ADMIN_KEY=setze-hier-ein-langes-geheimnis

# true = nichts wird wirklich gesendet, alles wird nur geloggt
DRY_RUN=false

# Kampagne startet pausiert. Über /admin/resume freigeben.
START_PAUSED=true
