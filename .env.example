# ── GoHighLevel ───────────────────────────────────────────────────────────────
# Private Integration Token (Settings → Private Integrations → New)
# Scopes: conversations.write, conversations/message.write, contacts.readonly,
#         contacts.write (Tagging bei Opt-out), locations.readonly (Tag-Liste)
GHL_TOKEN=pit-xxxxxxxxxxxxxxxxxxxxxxxx
GHL_LOCATION_ID=xxxxxxxxxxxxxxxxxxxx

# API-Version-Header. Conversations läuft auf 2021-04-15, Contacts auf 2021-07-28.
GHL_API_VERSION_CONVERSATIONS=2021-04-15
GHL_API_VERSION_CONTACTS=2021-07-28

# Optional: Absendernummer erzwingen (sonst nutzt GHL die Default-Nummer der Location)
# GHL_FROM_NUMBER=+6281234567890

# ── Varianten-Generator ───────────────────────────────────────────────────────
# Nur für den Button "Varianten schreiben" auf /settings. Ohne Key ist der
# Generator aus, alles andere läuft normal weiter. In GHL ist dafür nichts zu tun.
ANTHROPIC_API_KEY=

# Leer lassen: dann wird das neueste Sonnet-Modell automatisch gewählt und für
# 24 Stunden gecacht. Nur setzen, wenn du ein bestimmtes Modell erzwingen willst.
ANTHROPIC_MODEL=

# ── Startwerte ───────────────────────────────────────────────────────────────
# Alles ab hier sind nur Startwerte. Was du unter /settings speicherst, liegt in
# der Datenbank auf dem Volume, gilt sofort und überlebt Redeploys. Diese
# Variablen greifen nur, solange der Wert dort nie gesetzt wurde.

# ── Zielgruppe ───────────────────────────────────────────────────────────────
# tag = alle Kontakte mit diesem Tag (der Weg, der bei HighLevel funktioniert),
# smartlist = nur falls die API auf deiner Location Smart Lists hergibt,
# manual = nur CSV-Import / POST /admin/contacts
# Bequemer über die Seite /audience einstellen.
AUDIENCE_SOURCE=manual
AUDIENCE_ID=
AUDIENCE_SYNC_INTERVAL_MINUTES=60
AUDIENCE_PRUNE_ON_SYNC=true

# ── Tempo & Schutz ────────────────────────────────────────────────────────────
TZ=Asia/Makassar
DAILY_CAP=30
SEND_WINDOW_START=9
SEND_WINDOW_END=18
MIN_GAP_SECONDS=240
MAX_GAP_SECONDS=900
FOLLOWUP_AFTER_HOURS=48
MAX_MESSAGES_WITHOUT_REPLY=2

# ── Reply-Rate-Bremse ─────────────────────────────────────────────────────────
REPLY_RATE_WINDOW=25
REPLY_RATE_FLOOR=0.2
REPLY_RATE_MIN_SAMPLE=15
# Sends, die jünger sind als das, zählen nicht in die Rate. Bei Kaltkontakt
# kommen Antworten über Tage. 0 schaltet die Reifezeit ab.
REPLY_RATE_MATURITY_HOURS=24

# ── Betrieb ───────────────────────────────────────────────────────────────────
PORT=3000
DATA_DIR=/data
ADMIN_KEY=setze-hier-ein-langes-geheimnis
DRY_RUN=false
START_PAUSED=true

# pool.json ist nur die Erstbefüllung. Sobald Varianten in der Datenbank liegen,
# wird die Datei ignoriert, damit ein Deploy die im Editor geschriebenen Texte
# nicht überschreibt. true erzwingt das Überschreiben bei jedem Start.
POOL_SEED_ALWAYS=false
